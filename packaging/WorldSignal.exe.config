<?xml version="1.0" encoding="utf-8"?>
<!-- Copied next to WorldSignal.exe by tools/build.py. A zip downloaded from the internet marks every extracted file
     as "from the internet"; .NET Framework then refuses to load the pywebview DLLs (Python.Runtime.dll,
     Microsoft.Web.WebView2.Core.dll) and the window cannot open. This lets them load like local files. -->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
